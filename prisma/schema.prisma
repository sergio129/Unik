// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               Int      @id @default(autoincrement())
  username         String   @unique
  email            String?  @unique
  password         String
  nombre_completo  String?
  rol              String   @default("vendedor") // admin, vendedor, inventario
  activo           Boolean  @default(true)
  ultimo_acceso    DateTime?
  reset_token      String?
  reset_token_expiry DateTime?
  perfil           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  sesiones         Sesion[]
  notificaciones   Notificacion[]
  movimientos      MovimientoInventario[]
  pedidos          Pedido[]
  
  @@map("usuarios")
}

model Sesion {
  id               Int      @id @default(autoincrement())
  usuario_id       Int
  token            String   @unique
  ip_address       String?
  user_agent       String?
  fecha_expiracion DateTime
  activa           Boolean  @default(true)
  createdAt        DateTime @default(now())
  
  // Relaciones
  usuario          Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  
  @@map("sesiones")
}

model Categoria {
  id                 Int         @id @default(autoincrement())
  nombre             String
  descripcion        String?
  categoria_padre_id Int?
  activo             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  
  // Relaciones
  categoria_padre    Categoria?  @relation("CategoriaHijos", fields: [categoria_padre_id], references: [id])
  subcategorias      Categoria[] @relation("CategoriaHijos")
  productos          Producto[]
  
  @@map("categorias")
}

model UnidadMedida {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  abreviacion String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  productos   Producto[]
  
  @@map("unidades_medida")
}

model Producto {
  id                    Int      @id @default(autoincrement())
  codigo                String   @unique
  nombre                String
  descripcion           String?
  precio                Decimal  @db.Decimal(10, 2)
  precio_costo          Decimal? @db.Decimal(10, 2)
  stock                 Int      @default(0)
  stock_minimo          Int?     @default(5)
  categoria_id          Int
  unidad_medida_id      Int?
  imagen                String?
  activo                Boolean  @default(true)
  destacado             Boolean  @default(false)
  peso                  Decimal? @db.Decimal(8, 3)
  dimensiones           String?
  marca                 String?
  modelo                String?
  observaciones         String?
  fecha_vencimiento     DateTime?
  lote                  String?
  ubicacion             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relaciones
  categoria             Categoria @relation(fields: [categoria_id], references: [id])
  unidad_medida         UnidadMedida? @relation(fields: [unidad_medida_id], references: [id])
  movimientos           MovimientoInventario[]
  items_venta           ItemVenta[]
  codigos_barras        CodigoBarras[]
  historial_precios     HistorialPrecios[]
  detalles_pedido       DetallePedido[]
  productos_compuestos  ProductoCompuesto[] @relation("ProductoPrincipal")
  componentes           ProductoCompuesto[] @relation("ProductoComponente")
  
  @@map("productos")
}

model CodigoBarras {
  id          Int      @id @default(autoincrement())
  producto_id Int
  codigo      String   @unique
  tipo        String   @default("EAN13") // EAN13, UPC, CODE128, etc.
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  // Relaciones
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  
  @@map("codigos_barras")
}

model HistorialPrecios {
  id          Int      @id @default(autoincrement())
  producto_id Int
  precio      Decimal  @db.Decimal(10, 2)
  motivo      String?
  usuario_id  Int?
  createdAt   DateTime @default(now())
  
  // Relaciones
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  
  @@map("historial_precios")
}

model ProductoCompuesto {
  id                     Int     @id @default(autoincrement())
  producto_principal_id  Int
  producto_componente_id Int
  cantidad               Int     @default(1)
  activo                 Boolean @default(true)
  
  // Relaciones
  producto_principal     Producto @relation("ProductoPrincipal", fields: [producto_principal_id], references: [id], onDelete: Cascade)
  producto_componente    Producto @relation("ProductoComponente", fields: [producto_componente_id], references: [id], onDelete: Cascade)
  
  @@unique([producto_principal_id, producto_componente_id])
  @@map("productos_compuestos")
}

model MovimientoInventario {
  id           Int      @id @default(autoincrement())
  producto_id  Int
  tipo         String   // "entrada", "salida", "ajuste", "venta", "devolucion"
  cantidad     Int
  stock_anterior Int?
  stock_actual   Int?
  precio       Decimal? @db.Decimal(10, 2)
  motivo       String?
  referencia   String?
  usuario_id   Int?
  createdAt    DateTime @default(now())
  
  // Relaciones
  producto     Producto @relation(fields: [producto_id], references: [id])
  usuario      Usuario? @relation(fields: [usuario_id], references: [id])
  
  @@map("movimientos_inventario")
}

model Cliente {
  id               Int      @id @default(autoincrement())
  tipo_documento   String   @default("CC") // CC, NIT, CE, PAS
  numero_documento String   @unique
  nombre           String
  email            String?
  telefono         String?
  direccion        String?
  ciudad           String?
  departamento     String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relaciones
  ventas           Venta[]
  facturas         Factura[]
  
  @@map("clientes")
}

model Venta {
  id               Int      @id @default(autoincrement())
  numero_venta     String   @unique
  cliente_id       Int?
  subtotal         Decimal  @db.Decimal(10, 2)
  descuento        Decimal  @db.Decimal(10, 2) @default(0)
  impuestos        Decimal  @db.Decimal(10, 2) @default(0)
  total            Decimal  @db.Decimal(10, 2)
  metodo_pago      String   @default("efectivo") // efectivo, tarjeta, transferencia
  estado           String   @default("completada") // pendiente, completada, cancelada
  observaciones    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relaciones
  cliente          Cliente? @relation(fields: [cliente_id], references: [id])
  items            ItemVenta[]
  facturas         Factura[]
  
  @@map("ventas")
}

model ItemVenta {
  id          Int     @id @default(autoincrement())
  venta_id    Int
  producto_id Int
  cantidad    Int
  precio      Decimal @db.Decimal(10, 2)
  descuento   Decimal @db.Decimal(10, 2) @default(0)
  subtotal    Decimal @db.Decimal(10, 2)
  
  // Relaciones
  venta       Venta   @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [producto_id], references: [id])
  
  @@map("items_venta")
}

model Factura {
  id               Int      @id @default(autoincrement())
  numero_factura   String   @unique
  venta_id         Int?
  cliente_id       Int
  subtotal         Decimal  @db.Decimal(10, 2)
  descuento        Decimal  @db.Decimal(10, 2) @default(0)
  impuestos        Decimal  @db.Decimal(10, 2) @default(0)
  total            Decimal  @db.Decimal(10, 2)
  estado           String   @default("generada") // generada, enviada, pagada, anulada
  fecha_vencimiento DateTime?
  observaciones    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relaciones
  venta            Venta?   @relation(fields: [venta_id], references: [id])
  cliente          Cliente  @relation(fields: [cliente_id], references: [id])
  detalles         DetalleFactura[]
  
  @@map("facturas")
}

model DetalleFactura {
  id          Int     @id @default(autoincrement())
  factura_id  Int
  concepto    String
  cantidad    Int     @default(1)
  precio      Decimal @db.Decimal(10, 2)
  descuento   Decimal @db.Decimal(10, 2) @default(0)
  subtotal    Decimal @db.Decimal(10, 2)
  
  // Relaciones
  factura     Factura @relation(fields: [factura_id], references: [id], onDelete: Cascade)
  
  @@map("detalles_factura")
}

model Proveedor {
  id               Int      @id @default(autoincrement())
  nit              String?  @unique
  nombre           String
  contacto         String?
  telefono         String?
  email            String?
  direccion        String?
  ciudad           String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relaciones
  pedidos          Pedido[]
  
  @@map("proveedores")
}

model Pedido {
  id               Int      @id @default(autoincrement())
  numero_pedido    String   @unique
  proveedor_id     Int
  tipo             String   @default("compra") // compra, devolucion
  estado           String   @default("pendiente") // pendiente, enviado, recibido, cancelado
  subtotal         Decimal  @db.Decimal(10, 2)
  descuento        Decimal  @db.Decimal(10, 2) @default(0)
  impuestos        Decimal  @db.Decimal(10, 2) @default(0)
  total            Decimal  @db.Decimal(10, 2)
  fecha_esperada   DateTime?
  fecha_recepcion  DateTime?
  observaciones    String?
  usuario_id       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relaciones
  proveedor        Proveedor @relation(fields: [proveedor_id], references: [id])
  usuario          Usuario?  @relation(fields: [usuario_id], references: [id])
  detalles         DetallePedido[]
  seguimientos     SeguimientoPedido[]
  
  @@map("pedidos")
}

model DetallePedido {
  id               Int     @id @default(autoincrement())
  pedido_id        Int
  producto_id      Int
  cantidad         Int
  precio           Decimal @db.Decimal(10, 2)
  descuento        Decimal @db.Decimal(10, 2) @default(0)
  subtotal         Decimal @db.Decimal(10, 2)
  cantidad_recibida Int?   @default(0)
  
  // Relaciones
  pedido           Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto         Producto @relation(fields: [producto_id], references: [id])
  
  @@map("detalles_pedido")
}

model SeguimientoPedido {
  id          Int      @id @default(autoincrement())
  pedido_id   Int
  estado      String
  comentario  String?
  fecha       DateTime @default(now())
  
  // Relaciones
  pedido      Pedido   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  
  @@map("seguimiento_pedidos")
}

model Notificacion {
  id          Int      @id @default(autoincrement())
  usuario_id  Int?
  tipo        String   // info, warning, error, success
  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  url         String?
  datos       Json?
  createdAt   DateTime @default(now())
  
  // Relaciones
  usuario     Usuario? @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  
  @@map("notificaciones")
}
