{
  "name": "unika",
  "version": "1.0.0",
  "description": "Sistema web para gestión de negocio La UNIKa",
  "main": "api/index.js",
  "scripts": {
    "preinstall": "node -e \"process.env.PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true; process.env.PUPPETEER_SKIP_DOWNLOAD=true\"",
    "start": "node src/index-prisma.js",
    "dev": "nodemon src/index-prisma.js",
    "start:legacy": "node src/index.js",
    "dev:legacy": "nodemon src/index.js",
    "build": "npm run db:generate",
    "vercel-build": "npm run db:generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "node src/utils/seed.js",
    "init-admin": "node src/utils/initAdmin-prisma.js",
    "init-admin:legacy": "node src/utils/initAdmin.js",
    "migrate": "node src/migrations-cli.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-csv": "^5.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.1",
    "puppeteer": "^23.10.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^5.10.0"
  }
}
