{
  "name": "unika",
  "version": "1.0.0",
  "description": "Sistema web para gestión de negocio La UNIKa",
  "main": "src/index.js",
  "scripts": {
    "preinstall": "node -e \"process.env.PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true; process.env.PUPPETEER_SKIP_DOWNLOAD=true\"",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run db:generate",
    "vercel-build": "npm run db:generate && npm run db:deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node src/utils/seed.js",
    "init-admin": "node src/utils/initAdmin.js",
    "migrate": "node src/migrations-cli.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-csv": "^5.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.17.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "webhook-discord": "^3.7.8",
    "whatsapp-web.js": "^1.27.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "nodemon": "^3.1.10"
  }
}
